obdncs_T  = f_theme(obdncs,  color.new(#3f4f6b, 90), color.new(#6f6f6f, 90), color.new(#FF00E5, 90))
obactup_T = f_theme(obactup, color.new(#627598, 55), color.new(#9e9e9e, 55), color.new(#00E5FF, 55))
obactdn_T = f_theme(obactdn, color.new(#3f4f6b, 55), color.new(#6f6f6f, 55), color.new(#FF00E5, 55))
obshowbb     = input.bool(false, "Show Breakers", inline="bb", group=VBG, tooltip="Display Breakers")
color bbup         = input.color(color.new(#089981, 100), "", inline="bb", group=VBG)
