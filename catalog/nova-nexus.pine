ZONES_GROUP = "Premium & Discount Zones"
showPremiumDiscountZonesInput = input.bool(false, "Premium/Discount Zones", group = ZONES_GROUP, tooltip = "Display premium, discount, and equilibrium zones on chart")
zonesSwingLenInput            = input.int(50, "Swing Length", minval = 10, group = ZONES_GROUP)
