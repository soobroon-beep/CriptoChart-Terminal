//@version=5
indicator("CriptoChaman - Nova Nexus©", "Nova Nexus© - Personal v2", 
     overlay = true, 
     max_bars_back = 5000, 
     max_boxes_count = 500, 
     max_labels_count = 500, 
     max_lines_count = 500, 
     max_polylines_count = 100)

// ====================================================================================================================
// 📱 ESTRATEGIAS (separado — preset ligero)
// When enabled: specific modules are activated while others are forced OFF.
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
groupESTRATEGIAS = "📱 ESTRATEGIAS"
est1 = input.bool(false, "Estrategia - Mobile", group=groupESTRATEGIAS, tooltip="Activa: Smooth Trail + Reversal Bands + IA Signals. Desactiva lo demás.")
est2 = input.bool(false, "Estrategia - Cloud", group=groupESTRATEGIAS, tooltip="Activa: IA Signals + EMA Cloud + Volume Profile + Soporte y Resistencia. Desactiva lo demás.")
est3 = input.bool(false, "Estrategia - SMC", group=groupESTRATEGIAS, tooltip="Activa: IA Signals + SMC + Pivots + Volume Profile. Desactiva lo demás.")

// ====================================================================================================================
// 🔘 MASTER MODULE CONTROLS (TOP)
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
groupMASTER = "🧩 MÓDULOS (ON/OFF) 🧩"
enableIASignals     = input.bool(true,  "⚡ IA Signals",                 group=groupMASTER, tooltip="Activa/desactiva las señales de compra y venta generadas por IA (Nova Nexus Signals v2.7 con cooldown)")
enableSMC           = input.bool(true,  "🧠 SMC / Smart Money Concepts", group=groupMASTER)
enableEMA           = input.bool(true,  "☁️ EMA Cloud",                  group=groupMASTER)
enableSmoothTrail  = input.bool(false,  "🧵 Smooth Trail",               group=groupMASTER)
enablePivots        = input.bool(true,  "📍 Pivots",                     group=groupMASTER)
enableRevBands      = input.bool(false,  "🔄 Reversal Bands",             group=groupMASTER)
enableVolumeProfile = input.bool(false,  "📊 Volume Profile",             group=groupMASTER)
enableLiquidations  = input.bool(false,  "💥 Liquidations",               group=groupMASTER)
enableSR             = input.bool(false, "🧱 Soporte y Resistencia",     group=groupMASTER, tooltip="Activa/desactiva el módulo Breaks and Retests [HG] integrado")
// ====================================================================================================================

// Effective module toggles (do NOT change calculations, only gates)
enableIASignals_E     = est1 ? true  : est2 ? true  : est3 ? true  : enableIASignals
enableSMC_E           = est1 ? false : est2 ? false : est3 ? true  : enableSMC
enableEMA_E           = est1 ? false : est2 ? true  : est3 ? false : enableEMA
enableSmoothTrail_E   = est1 ? true  : est2 ? false : est3 ? false : enableSmoothTrail
enablePivots_E        = est1 ? false : est2 ? false : est3 ? true  : enablePivots
enableRevBands_E      = est1 ? true  : est2 ? false : est3 ? false : enableRevBands
enableVolumeProfile_E = est1 ? false : est2 ? true  : est3 ? true  : enableVolumeProfile
enableLiquidations_E  = est1 ? false : est2 ? false : est3 ? false : enableLiquidations
enableSR_E            = est1 ? false : est2 ? true  : est3 ? false : enableSR


// ====================================================================================================================

////////////////////////////////////////////////////////////////
// 🎨 THEME SELECTOR (visual only)
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
groupTHEME = '🎨 TEMA / THEME'
themeStyle = input.string('Default', '🎨 Selector', options = ['Default', 'Blue', 'Minimal Gray', 'High Contrast'], group = groupTHEME)
themeCandleOverride = input.bool(false, '🕯️ Velas según Tema', group = groupTHEME)

f_theme(defCol, blueCol, grayCol, contrastCol) =>
    themeStyle == 'Default' ? defCol :
     themeStyle == 'Blue' ? blueCol :
     themeStyle == 'Minimal Gray' ? grayCol :
     contrastCol


