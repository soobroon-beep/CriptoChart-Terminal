equilibriumZoneColor_T  = f_theme(equilibriumZoneColorInput,  color.new(#8a97b3, 0), color.new(#bdbdbd, 0), color.new(#FFFF00, 0))
discountZoneColor_T     = f_theme(discountZoneColorInput,     color.new(#3f4f6b, 0), color.new(#757575, 0), color.new(#FF00E5, 0))

fvg_enable   = input.bool(false, "", inline="1", group="FAIR VALUE GAP", tooltip="Display fair value gap")
what_fvg     = input.string("FVG", "", inline="1", group="FAIR VALUE GAP", tooltip="Display fair value gap", 
 options=["FVG", "Breakers"])
fvg_num      = input.int(5, "Show Last", inline="1a", group="FAIR VALUE GAP", tooltip="Number of fvg to show", minval=0)
fvg_upcss    = input.color(color.new(#089981, 80), "", inline="1", group="FAIR VALUE GAP")
fvg_dncss    = input.color(color.new(#f23645, 80), "", inline="1", group="FAIR VALUE GAP")

// Theme colors
fvg_upcss_T = f_theme(fvg_upcss, color.new(#627598, 80), color.new(#b0b0b0, 80), color.new(#00E5FF, 80))
fvg_dncss_T = f_theme(fvg_dncss, color.new(#3f4f6b, 80), color.new(#7a7a7a, 80), color.new(#FF00E5, 80))
