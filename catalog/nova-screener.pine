[s35, dv35, p35] = request.security(sym35, timeframe.period, f_sig(), lookahead=barmerge.lookahead_off)
[s36, dv36, p36] = request.security(sym36, timeframe.period, f_sig(), lookahead=barmerge.lookahead_off)
