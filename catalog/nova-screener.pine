    cnt35 := cnt35 - 1
else
    ps35 := 0, pdv35 := false

if s36 != 0
    ps36 := s36, pdv36 := dv36, cnt36 := sigBars
else if cnt36 > 0
    cnt36 := cnt36 - 1
else
    ps36 := 0, pdv36 := false

if s37 != 0
    ps37 := s37, pdv37 := dv37, cnt37 := sigBars
else if cnt37 > 0
    cnt37 := cnt37 - 1
else
    ps37 := 0, pdv37 := false

if s38 != 0
    ps38 := s38, pdv38 := dv38, cnt38 := sigBars
else if cnt38 > 0
    cnt38 := cnt38 - 1
else
    ps38 := 0, pdv38 := false

if s39 != 0
    ps39 := s39, pdv39 := dv39, cnt39 := sigBars
else if cnt39 > 0
    cnt39 := cnt39 - 1
else
    ps39 := 0, pdv39 := false

if s40 != 0
    ps40 := s40, pdv40 := dv40, cnt40 := sigBars
else if cnt40 > 0
    cnt40 := cnt40 - 1
else
    ps40 := 0, pdv40 := false

// =========================================================================
// HELPERS DE CELDA (con tema dinámico)
// =========================================================================
cellTxt(int sig, bool dvg, int elapsed) =>
    rng  = math.abs(sig) == 2
    bars = " (" + str.tostring(elapsed) + ")"
    if sig > 0
        dvg ? "◆ DIV+" + bars : rng ? "▲ RNG" + bars : "▲ LONG" + bars
    else if sig < 0
        dvg ? "◆ DIV-" + bars : rng ? "▼ RNG" + bars : "▼ SHORT" + bars
    else
        "·"

cellBg(int sig, bool dvg) =>
    rng = math.abs(sig) == 2
    if sig > 0
        dvg ? t_div : rng ? t_rng : t_long
    else if sig < 0
        dvg ? t_div : rng ? t_rng : t_short
    else
        t_empty

cellFg(int sig, bool dvg) =>
    if sig != 0
        dvg ? t_sigDiv : t_sigTxt
    else
        t_emTxt

symName(string s) =>
    str.length(s) == 0 ? "—" : s

// =========================================================================
// TABLA
// =========================================================================
// Desktop: texto normal (más grande) | Móvil: texto small (más legible que antes)
nCols = 4
nRows = 21

var table t = table.new(tPos, nCols, nRows, bgcolor=t_bg, border_color=t_border, border_width=2, frame_color=t_frame, frame_width=3)

symArr = array.from(sym01,sym02,sym03,sym04,sym05,sym06,sym07,sym08,sym09,sym10,sym11,sym12,sym13,sym14,sym15,sym16,sym17,sym18,sym19,sym20,sym21,sym22,sym23,sym24,sym25,sym26,sym27,sym28,sym29,sym30,sym31,sym32,sym33,sym34,sym35,sym36,sym37,sym38,sym39,sym40)
sigArr = array.from(ps01,ps02,ps03,ps04,ps05,ps06,ps07,ps08,ps09,ps10,ps11,ps12,ps13,ps14,ps15,ps16,ps17,ps18,ps19,ps20,ps21,ps22,ps23,ps24,ps25,ps26,ps27,ps28,ps29,ps30,ps31,ps32,ps33,ps34,ps35,ps36,ps37,ps38,ps39,ps40)
dvArr  = array.from(pdv01,pdv02,pdv03,pdv04,pdv05,pdv06,pdv07,pdv08,pdv09,pdv10,pdv11,pdv12,pdv13,pdv14,pdv15,pdv16,pdv17,pdv18,pdv19,pdv20,pdv21,pdv22,pdv23,pdv24,pdv25,pdv26,pdv27,pdv28,pdv29,pdv30,pdv31,pdv32,pdv33,pdv34,pdv35,pdv36,pdv37,pdv38,pdv39,pdv40)
cntArr = array.from(cnt01,cnt02,cnt03,cnt04,cnt05,cnt06,cnt07,cnt08,cnt09,cnt10,cnt11,cnt12,cnt13,cnt14,cnt15,cnt16,cnt17,cnt18,cnt19,cnt20,cnt21,cnt22,cnt23,cnt24,cnt25,cnt26,cnt27,cnt28,cnt29,cnt30,cnt31,cnt32,cnt33,cnt34,cnt35,cnt36,cnt37,cnt38,cnt39,cnt40)

// Tamaño de texto: small en móvil (antes tiny), normal en desktop (antes small) — más grande y legible
tSz = mobileOn ? size.small : size.normal

// Header — siempre 4 columnas, con iconos para look más moderno
table.cell(t, 0, 0, "💠 SÍMBOLO", text_color=t_htxt, bgcolor=t_hbg, text_size=tSz, text_halign=text.align_center, text_font_family=font.family_monospace)
table.cell(t, 1, 0, "⚡ SEÑAL",   text_color=t_htxt, bgcolor=t_hbg, text_size=tSz, text_halign=text.align_center, text_font_family=font.family_monospace)
table.cell(t, 2, 0, "💠 SÍMBOLO", text_color=t_htxt, bgcolor=t_hbg, text_size=tSz, text_halign=text.align_center, text_font_family=font.family_monospace)
table.cell(t, 3, 0, "⚡ SEÑAL",   text_color=t_htxt, bgcolor=t_hbg, text_size=tSz, text_halign=text.align_center, text_font_family=font.family_monospace)

// Filas — siempre 2 símbolos por fila, 20 filas
for row = 1 to 20
    iL   = row - 1
    iR   = row + 19
    sigL = array.get(sigArr, iL)
    dvL  = array.get(dvArr,  iL)
    sigR = array.get(sigArr, iR)
    dvR  = array.get(dvArr,  iR)
    elL  = sigL != 0 ? sigBars - array.get(cntArr, iL) : 0
    elR  = sigR != 0 ? sigBars - array.get(cntArr, iR) : 0
    rBg  = row % 2 == 0 ? t_rEven : t_rOdd
    table.cell(t, 0, row, symName(array.get(symArr,iL)), text_color=t_sym,           bgcolor=rBg,               text_size=tSz, text_halign=text.align_left,   text_font_family=font.family_monospace)
    table.cell(t, 1, row, cellTxt(sigL, dvL, elL),       text_color=cellFg(sigL,dvL), bgcolor=cellBg(sigL,dvL), text_size=tSz, text_halign=text.align_center, text_font_family=font.family_monospace)
    table.cell(t, 2, row, symName(array.get(symArr,iR)), text_color=t_sym,           bgcolor=rBg,               text_size=tSz, text_halign=text.align_left,   text_font_family=font.family_monospace)
    table.cell(t, 3, row, cellTxt(sigR, dvR, elR),       text_color=cellFg(sigR,dvR), bgcolor=cellBg(sigR,dvR), text_size=tSz, text_halign=text.align_center, text_font_family=font.family_monospace)

// =========================================================================
// ALERTAS DINÁMICAS AGRUPADAS (SOLUCIÓN ANTI-SPAM PARA DISCORD)
// =========================================================================
rawSigArr = array.from(s01,s02,s03,s04,s05,s06,s07,s08,s09,s10,s11,s12,s13,s14,s15,s16,s17,s18,s19,s20,s21,s22,s23,s24,s25,s26,s27,s28,s29,s30,s31,s32,s33,s34,s35,s36,s37,s38,s39,s40)
rawPrcArr = array.from(p01,p02,p03,p04,p05,p06,p07,p08,p09,p10,p11,p12,p13,p14,p15,p16,p17,p18,p19,p20,p21,p22,p23,p24,p25,p26,p27,p28,p29,p30,p31,p32,p33,p34,p35,p36,p37,p38,p39,p40)

string listaSenales = ""
int contadorSenales = 0

for i = 0 to 39
    string currentSym = array.get(symArr, i)
    int currentSig = array.get(rawSigArr, i)
    float currentPrice = array.get(rawPrcArr, i)
    
    if currentSig != 0 and currentSym != ""
        string dirText = currentSig > 0 ? "🟢 LONG" : "🔴 SHORT"
        string priceText = str.tostring(currentPrice, "#.########")
        
        listaSenales := listaSenales + "🔸 **" + currentSym + "** | " + dirText + " | Entrada: $" + priceText + "\\n"
        contadorSenales := contadorSenales + 1

if contadorSenales > 0
    string titulo = "🚨 " + str.tostring(contadorSenales) + " NUEVAS SEÑALES DETECTADAS"
    string jsonMsg = '{"username": "Nova Nexus Screener", "embeds": [{"title": "' + titulo + '", "color": 16766720, "description": "' + listaSenales + '", "footer": {"text": "Nova Nexus 2.0 | TF: ' + timeframe.period + 'm"}}]}'
    alert(jsonMsg, alert.freq_once_per_bar_close)
