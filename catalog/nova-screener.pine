//@version=5
indicator("Nova Nexus — Screener 40 Cryptos", "Nova Nexus© - Screener 2.0", overlay = false)

// =========================================================================
// VISUALIZACIÓN
// =========================================================================
grpVis   = "🎨  Visualización"
mobileOn = input.bool(false, "📱 Modo Móvil", group=grpVis, tooltip="Activa para ver tabla compacta en celular.")
posOpt   = input.string("Abajo Derecha", "📍 Posición", options=["Arriba Derecha","Arriba Izquierda","Abajo Derecha","Abajo Izquierda"], group=grpVis)

tPos = switch posOpt
    "Arriba Derecha"   => position.top_right
    "Arriba Izquierda" => position.top_left
    "Abajo Izquierda"  => position.bottom_left
    => position.bottom_right

// =========================================================================
// TEMA: DARK GLASS NEÓN (rediseñado — mayor contraste y saturación)
// =========================================================================
t_bg     = color.new(#0a0a14, 0)   // fondo casi negro, tinte azul profundo
t_hbg    = color.new(#1c1c3d, 0)   // header violeta oscuro premium
t_htxt   = color.new(#a5a5ff, 0)   // lavanda neón brillante
t_rEven  = color.new(#13131f, 0)
t_rOdd   = color.new(#0c0c16, 0)
t_sym    = color.new(#eaeaff, 0)   // símbolo casi blanco, tinte lavanda
t_long   = color.new(#00e676, 0)   // verde neón vívido
t_short  = color.new(#ff2d55, 0)   // rojo/rosa neón vívido
t_rng    = color.new(#b366ff, 0)   // púrpura neón
t_div    = color.new(#ffc400, 0)   // dorado brillante
t_empty  = color.new(#0a0a14, 0)
t_sigTxt = color.new(#ffffff, 0)
t_sigDiv = color.new(#14141c, 0)
t_emTxt  = color.new(#40405c, 0)
t_border = color.new(#33336b, 0)   // borde violeta más visible
t_frame  = color.new(#8a6bff, 0)   // marco exterior neón

