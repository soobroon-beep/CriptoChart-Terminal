// =========================================================================
// FILTROS
// =========================================================================
grpFilt  = "⚙️  Filtros"
minScore = input.int(1, "Score mínimo",          minval=1, maxval=5, group=grpFilt, tooltip="1=todas | 5=solo perfectas")
sigBars  = input.int(7, "Duración señal (velas)", minval=1, maxval=50, group=grpFilt)

// =========================================================================
// PARÁMETROS INTERNOS
// =========================================================================
int   _len     = 20
int   _sig     = 3
int   _dfl     = 30
float _obLevel = 40.0
float _osLevel = -40.0
float _obRange = 35.0
float _osRange = -35.0
int   _emaLen  = 200
float _mfMin   = 3.0
int   _adxLen  = 14
float _adxThr  = 25.0
int   _divLook = 5
int   _divTrs  = 25

// =========================================================================
// LÓGICA DE SEÑAL
// =========================================================================
f_sig() =>
    _hl2   = math.avg(high, low)
    _av    = ta.sma(_hl2, _len)
    _hh    = ta.highest(_hl2, _len)
    _ll    = ta.lowest(_hl2, _len)
    _hlAvg = math.avg(math.avg(_hh, _ll), _av)
    _atr   = ta.rma(math.max(math.max(high - low, math.abs(high - close[1])), math.abs(low - close[1])), _len)
    oscV   = ta.linreg((close - _hlAvg) / _atr * 100, _len, 0)
    sigV   = ta.sma(oscV, _sig)
    _haC   = math.avg(open, high, low, close)
    var float _haO = na
    _haO  := na(_haO[1]) ? math.avg(open, close) : math.avg(_haO[1], _haC[1])
    _haH   = math.max(high, math.max(_haO, _haC))
    _haL   = math.min(low,  math.min(_haO, _haC))
    _haAtr = ta.rma(math.max(math.max(_haH - _haL, math.abs(_haH - _haC[1])), math.abs(_haL - _haC[1])), _dfl)
    _fUp   = ta.rma(math.max(ta.change(_haH), 0), _dfl) / _haAtr
    _fDn   = ta.rma(math.max(-ta.change(_haL), 0), _dfl) / _haAtr
    fluxV  = ta.rma((_fUp - _fDn) / (_fUp + _fDn), _dfl / 2) * 100
    emaV   = ta.ema(close, _emaLen)
    [_, __, adxV] = ta.dmi(_adxLen, _adxLen)
    isRng  = adxV < _adxThr
    obU    = isRng ? _obRange : _obLevel
    osU    = isRng ? _osRange : _osLevel
    inOB   = oscV >= obU
    inOS   = oscV <= osU
    xBuy   = ta.crossover(oscV, sigV)  and inOS
    xSell  = ta.crossunder(oscV, sigV) and inOB
    mfU    = isRng ? _mfMin / 2 : _mfMin
    f3Buy  = fluxV >  mfU
    f3Sell = fluxV < -mfU
    f2Buy  = not isRng ? close > emaV : true
    f2Sell = not isRng ? close < emaV : true
    ppLow  = ta.lowest(low,   _divLook)
    ppHigh = ta.highest(high, _divLook)
    opLow  = ta.lowest(oscV,  _divLook)
    opHigh = ta.highest(oscV, _divLook)
    dBull  = low  < ppLow[1]  and oscV > opLow[1]  and oscV < -_divTrs and xBuy
    dBear  = high > ppHigh[1] and oscV < opHigh[1] and oscV >  _divTrs and xSell
    scBuy  = (inOS ? 1:0) + (close > emaV ? 1:0) + (f3Buy  ? 1:0) + (not isRng ? 1:0) + (dBull ? 1:0)
    scSell = (inOB ? 1:0) + (close < emaV ? 1:0) + (f3Sell ? 1:0) + (not isRng ? 1:0) + (dBear ? 1:0)
    fBuy   = xBuy  and f2Buy  and f3Buy  and scBuy  >= minScore
    fSell  = xSell and f2Sell and f3Sell and scSell >= minScore
    isDvg  = (fBuy and dBull) or (fSell and dBear)
    sigEnc = fBuy ? (isRng ? 2 : 1) : fSell ? (isRng ? -2 : -1) : 0
    [sigEnc, isDvg, close]

// =========================================================================
// REQUEST.SECURITY — 1 llamada por símbolo (Con Precio)
// =========================================================================
[s01, dv01, p01] = request.security(sym01, timeframe.period, f_sig(), lookahead=barmerge.lookahead_off)
[s02, dv02, p02] = request.security(sym02, timeframe.period, f_sig(), lookahead=barmerge.lookahead_off)
[s03, dv03, p03] = request.security(sym03, timeframe.period, f_sig(), lookahead=barmerge.lookahead_off)
