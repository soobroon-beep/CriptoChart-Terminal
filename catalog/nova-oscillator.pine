//@version=5
indicator("Nova Oscillator ", "Nova Nexus© - Oscillator 1.1", false, explicit_plot_zorder = true, max_lines_count = 500, max_labels_count = 500)

_                                                                                                                                                                                                                                   ='  
                           +-----------------------+
                           ┃       Constants       ┃
                           +-----------------------+                                                                                                                                                                                   '//{

const string tg  = 'Choose how to display the Confluence Gauges.'
const string tm  = 'Calibrates the length of the main oscillator ribbon as well as the period for the squeeze algorithm.'
const string ts  = 'Controls the width of the ribbon.\nLower values result in faster responsiveness at the cost of premature positives.'
const string td  = 'Adjusts a threshold to limit the amount of divergences detected based on strength.\nHigher values result in less detections.'

// Grupos rebautizados al estilo Metztli 
const string go  = 'Momentum '
const string gd  = 'Flux '
const string gl  = 'Divergences '
const string gg  = 'Gauges by Vxtrsbxn '

const string ss  = 'Sell Signal'       
const string sb  = 'Buy  Signal'       
const string sob = 'Momentum Bullish'  
const string sos = 'Momentum Bearish'  
const string sfb = 'Flux     Bullish'  
const string sfs = 'Flux     Bearish'  
const string ssb = 'Bullish Swing'     
const string sss = 'Bearish Swing'     
const string sgb = 'Strong Bull Gauge' 
const string sgs = 'Strong Bear Gauge' 
const string swb = 'Weak   Bull Gauge' 
const string sws = 'Weak   Bear Gauge' 
const string shs = 'High   Squeeze'    
const string sms = 'Normal Squeeze'    
const string sls = 'Low    Squeeze'    
const string sds = 'Bearish Divergence'
const string sdb = 'Bullish Divergence'

const color colup = #ffcfa6
const color coldn = #419fec
const color colpf = #ffd0a6
const color coldf = #4683b4
const color colps = #169b5d
const color colng = #970529
const color colpo = #11cf77
const color colno = #d11645
const color colsh = #ff1100
const color colsm = #ff5e00
const color colsl = #ffa600
const color colnt = #787b8635
var   color coltx = chart.fg_color
var   color trnsp = chart.bg_color

//}

_                                                                                                                                                                                                                                   ='  
                           +-----------------------+
                           ┃        Inputs         ┃
                           +-----------------------+                                                                                                                                                                                   '//{

dfb = input.bool  (true  , ""              ,                                       inline = '1', group = gd)
dfl = input.int   (30    , "Length   "     ,  7 ,           50,            1 ,     inline = '1', group = gd)
dfh = input.bool  (false , "Trend Bias"    ,                                                     group = gd)
cps = input.color (colps ,  ""             ,                                       inline = '2', group = gd)
cng = input.color (colng ,  ""             ,                                       inline = '2', group = gd)
cpo = input.color (colpo ,  ""             ,                                       inline = '3', group = gd)
cno = input.color (colno ,  ""             ,                                       inline = '3', group = gd)
smb = input.bool  (true  , ""              ,                                       inline = '1', group = go)
len = input.int   (20    , "Length   "     ,  7 ,           50,            1 , tm,          '1',         go)
sig = input.int   (3     , "Signal       " ,  2 ,            7,            1 , ts,               group = go)
cup = input.color (colup ,  ""             ,                                       inline = '2', group = go)
cdn = input.color (coldn ,  ""             ,                                       inline = '2', group = go)
cpf = input.color (colpf ,  ""             ,                                       inline = '3', group = go)
cdf = input.color (coldf ,  ""             ,                                       inline = '3', group = go)
trs = input.int   (25    , "Sensitivity   ",  20,           40,            1 , td,               group = gl)
dbl = input.bool  (true  , "Lines"         ,                                                     group = gl)
dbs = input.bool  (true  , "Labels"        ,                                                     group = gl)
cdu = input.color (colpo ,  ""             ,                                       inline = '1', group = gl)
cdd = input.color (colno ,  ""             ,                                       inline = '1', group = gl)
gds = input.string('Both', "Showcase     " , ['Both', 'Bull', 'Bear', 'None'], tg,          '4',         gg)
cgp = input.color (colps ,  ""             ,                                       inline = '2', group = gg)
cgn = input.color (colng ,  ""             ,                                       inline = '2', group = gg)

//}

_                                                                                                                                                                                                                                   ='  
                           +-----------------------+
                           ┃         UDTs          ┃
                           +-----------------------+                                                                                                                                                                                   '//{

type bar
    float o = open
    float h = high
    float l = low
    float c = close
    int   i = bar_index

type osc
    float o = na
    float s = na

type squeeze
    bool  h = false
    bool  m = false
    bool  l = false

type gauge
    float u = na
    float l = na
    color c = chart.fg_color
    bool  p = true

type divergence
    float p = na
    float s = na
    int   i = na

type alerts
    bool  b = false
    bool  s = false
    bool  u = false
    bool  d = false
    bool  p = false
    bool  n = false
    bool  x = false
    bool  y = false
    bool  a = false
    bool  c = false
    bool  q = false
    bool  w = false
    bool  h = false
    bool  m = false
    bool  l = false
    bool  e = false
    bool  f = false

type prompt
    string s = ''
    bool   c = false

//}

_                                                                                                                                                                                                                                   ='  
                           +-----------------------+
                           ┃        Methods        ┃
                           +-----------------------+                                                                                                                                                                                   '//{

method notify(prompt p) =>
    if p.c
        alert(p.s, alert.freq_once_per_bar_close)
        
method any(alerts a) =>
    string s = switch
        a.s => ss       
        a.b => sb       
        a.u => sob  
        a.d => sos  
        a.p => sfb  
        a.n => sfs  
        a.x => sss     
        a.y => ssb     
        a.q => sgb 
        a.w => sgs 
        a.a => swb 
        a.c => sws 
        a.h => shs    
        a.m => sms    
        a.l => sls    
        a.e => sds
        a.f => sdb
        =>      na

    prompt.new(s, not na(s))
        
method src(bar b, simple string src) =>
    float x = switch src
        'oc2'   => math.avg(b.o, b.c          )
        'hl2'   => math.avg(b.h, b.l          )
        'hlc3'  => math.avg(b.h, b.l, b.c     )
        'ohlc4' => math.avg(b.o, b.h, b.l, b.c)
        'hlcc4' => math.avg(b.h, b.l, b.c, b.c)

    x

method ha(bar b, simple bool p = true) =>
    var bar x = bar.new(       )
    x.c      := b  .src('ohlc4')
    x        := bar.new(
         na(x.o[1]) ? b.src('oc2') : nz(x.src('oc2')[1]),
         math.max(b.h, math.max(x.o, x.c))              ,
         math.min(b.l, math.min(x.o, x.c))              ,
         x.c                                            )

    p ? x : b

method atr(bar b, simple int len = 1) =>
    float tr =
         na      (   b.h[1]          ) ?
                     b.h    - b.l      :
         math.max(
         math.max(
                     b.h    - b.l      ,
         math.abs(   b.h    - b.c[1])) ,
         math.abs(   b.l    - b.c[1]))

    len == 1 ? tr : ta.rma(tr, len)

method stdev(float src, simple int len) =>
    float sq  = 0.
    float psq = 0.
    float sum = 0.
    
    for k = 0 to len - 1
        val  = nz(src[k])
        psq :=        sq
        sq  += (val - sq) / (1   + k  )
        sum += (val - sq) * (val - psq)
        
    math.sqrt(sum / (len - 1))

method osc(bar b, simple int sig, simple int len) =>
    float av = ta .sma(b.src('hl2'), len)
    bar   z  = bar.new(
                         b.o            ,
                         ta.highest(len),
                         ta.lowest (len),
                         b.c            )
    
    float x  = ta.linreg((z.c - math.avg(z.src('hl2'), av)) / z.atr() * 100, len, 0)

    osc.new(x, ta.sma(x, sig))

method dfo(bar b, simple int len) =>
    float tr = b .atr   (               len)
    float up = ta.rma   (
             math.max   (
               ta.change(b.h)     , 0), len) / (tr)
    float dn = ta.rma   (
             math.max   (
               ta.change(b.l) * -1, 0), len) / (tr)
    float x  = ta.rma   (
             (up - dn) / (up + dn)    , len  / 2) * 100

    osc.new(
              x        , 
              x > +25  ? 
             (x -  25) : 
              x < -25  ? 
             (x +  25) : 
              na       )

method sqz(bar b, simple int len) =>
    array<bool> sqz = array.new<bool>(   )
    float       dev = b.c  .stdev    (len)
    float       atr = b    .atr      (len)

    for i = 2 to 4
        sqz.unshift(dev < (atr * 0.25 * i))

    squeeze.new(sqz.pop(), sqz.pop(), sqz.pop())

method draw(bar b, osc o, simple int trs, simple bool s) =>
    var divergence d = divergence.new(          )
    bool           u = ta.crossunder (o.o  , o.s)
    bool           l = ta.crossover  (o.o  , o.s)
    float          x =                o.s
    bool           p =                false

    switch
        o.o >  trs and u and barstate.isconfirmed =>
            switch
                na(d.p) =>
                    d     := divergence.new(b.h, x, b.i)
                    p     := false

                not na(d.p) =>
                    if b.h > d.p and x < d.s
                        if s
                            line.new(d.i, d.s, b.i, x, xloc.bar_index, extend.none, cdd)
                        d := divergence.new(           )
                        p := true
                    else
                        d := divergence.new(b.h, x, b.i)
                        p := false
            
        o.o < -trs and l and barstate.isconfirmed =>
            switch
                na(d.p) =>
                    d     := divergence.new(b.l, x, b.i)
                    p     := false

                not na(d.p) =>
                    if b.l < d.p and x > d.s
                        if s
                            line.new(d.i, d.s, b.i, x, xloc.bar_index, extend.none, cdu)
                        d := divergence.new(           )
                        p := true
                    else
                        d := divergence.new(b.l, x, b.i)
                        p := false
    
    p

//}

_                                                                                                                                                                                                                                   ='  
                           +-----------------------+
                           ┃         Calc          ┃
                           +-----------------------+                                                                                                                                                                                   '//{

bar     b = bar      .new (           )
squeeze s = b        .sqz (        len)
osc     o = b        .osc (sig,    len)
osc     v = b.ha(dfh).dfo (        dfl)
bool    p = b        .draw(o, trs, dbl)
gauge   u = gauge    .new (
     +75                              ,
     +70                              ,
     v.o >   0     and o.o >   0      ? 
               cgp                    : 
     v.o >   0     or  o.o >   0      ? 
     color.new(cgp  , 40)             : 
               colnt                  ,
     gds == 'Both' or  gds == 'Bull'  )
gauge   d = gauge    .new (
     -75                              ,
     -70                              ,
     v.o <   0     and o.o <   0      ? 
               cgn                    : 
     v.o <   0     or  o.o <   0      ? 
     color.new(cgn  , 40)             : 
               colnt                  ,
     gds == 'Both' or  gds == 'Bear'  )

alerts  a = alerts   .new (
                           ta.crossover (o.o,     o.s) and o.o < -40 and v.o < 0    ,
                           ta.crossunder(o.o,     o.s) and o.o > +40 and v.o > 0    ,
                           ta.crossover (o.o,       0)                              ,
                           ta.crossunder(o.o,       0)                              ,
                           ta.crossover (v.o,       0)                              ,
                           ta.crossunder(v.o,       0)                              ,
                           ta.crossunder(o.o,     o.s) and smb                      ,
                           ta.crossover (o.o,     o.s) and smb                      ,
                           ta.change    (u.c == colnt) and u.c == color.new(cgp, 40),
                           ta.change    (d.c == colnt) and d.c == color.new(cgn, 40),
                           ta.change    (u.c == colnt) and u.c ==           cgp     ,
                           ta.change    (d.c == colnt) and d.c ==           cng     ,
                           ta.change    (s.h         ) and s.h                      ,
                           ta.change    (s.m         ) and s.m                      ,
                           ta.change    (s.l         ) and s.l                      ,
                           p                           and o.o >  trs               ,
                           p                           and o.o < -trs               )

//}

_                                                                                                                                                                                                                                   ='  
                           +-----------------------+
                           ┃        Visuals        ┃
                           +-----------------------+                                                                                                                                                                                   '//{

color colsq = s.h       ?           colsh      : s.m ?     colsm      : colsl
color colvf = v.o > 0   ? color.new(cps  , 70) : color.new(cng  , 70)
color colof = v.s > 0   ? color.new(cpo  , 70) : color.new(cno  , 70)
color colsf = o.o > o.s ? color.new(cpf  , 50) : color.new(cdf  , 50)
color colzf = o.o > o.s ?           cup      :             cdn

m  = hline(0             , "Mid-Line"   , color.new(coltx, 70),    hline.style_dashed                                   )
l  = plot (dfb ? v.o : na, "Flux"       ,           colvf     , 1, plot.style_area                                      )
z  = plot (dfb ? v.s : na, "OverFlux"   ,           colof     , 1, plot.style_areabr                                    )
w  = plot (smb ? o.o : na, "Mom"        ,           colzf     , 1, plot.style_line                                      )
q  = plot (s.l ?   1 : na, "Squeeze"    ,           colsq     , 1, plot.style_columns, false, -1, display = display.pane)
j  = plot (a.x ? o.s : na, "Trend Shift",           cdf       , 2, plot.style_circles,            display = display.pane)
k  = plot (a.y ? o.o : na, "Trend Shift",           cpf       , 2, plot.style_circles,            display = display.pane)
c  = plot (smb ? o.s : na, "Signal"     ,                                                         display = display.none)
ll = plot (d.p ? d.l : na, "Lower Gauge",                                                         display = display.none)
hl = plot (d.p ? d.u : na, "Lower Gauge",                                                         display = display.none)
hh = plot (u.p ? u.u : na, "Upper Gauge",                                                         display = display.none)
lh = plot (u.p ? u.l : na, "Upper Gauge",                                                         display = display.none)

plotshape(u.p and a.s ? u.u + 10 : na, "Confluence Sell"   , shape.triangledown, location.absolute, colno, size = size.tiny)
plotshape(d.p and a.b ? d.l - 15 : na, "Confluence Buy "   , shape.triangleup  , location.absolute, colpo, size = size.tiny)
plotshape(dbs and a.e ? o.s +  3 : na, "Bearish Divergence", shape.labeldown   , location.absolute, colnt, 0, '𝐃▾', colsm  )
plotshape(dbs and a.f ? o.s -  3 : na, "Bullish Divergence", shape.labelup     , location.absolute, colnt, 0, '𝐃▴', colsm  )

fill(w , c , colsf)
fill(lh, hh, u.c  )
fill(ll, hl, d.c  )

//}

_                                                                                                                                                                                                                                   ='  
                           +-----------------------+
                           ┃        Alerts         ┃
                           +-----------------------+                                                                                                                                                                                   '//{

alertcondition(a.s, "Confluence Sell"            , ss )
alertcondition(a.b, "Confluence Buy "            , sb )
alertcondition(a.u, "Momentum Midline Crossover ", sob)
alertcondition(a.d, "Momentum Midline Crossunder", sos)
alertcondition(a.p, "Flux     Midline Crossover ", sfb)
alertcondition(a.n, "Flux     Midline Crossunder", sfs)
alertcondition(a.y, "Momentum Swing   Crossover ", ssb)
alertcondition(a.x, "Momentum Swing   Crossunder", sss)
alertcondition(a.q, "Strong Bullish Confluence"  , sgb)
alertcondition(a.w, "Strong Bearish Confluence"  , sgs)
alertcondition(a.a, "Weak   Bullish Confluence"  , swb)
alertcondition(a.c, "Weak   Bearish Confluence"  , sws)
alertcondition(a.h, "High   Squeeze"             , shs)
alertcondition(a.m, "Normal Squeeze"             , sms)
alertcondition(a.l, "Low    Squeeze"             , sls)
alertcondition(a.e, "Bearish Divergence"         , sds)
alertcondition(a.f, "Bullish Divergence"         , sdb)

a.any().notify()

//}

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 💪 FUERZA DEL MOVIMIENTO — ADX + Confirmación Cruzada + Volatilidad
// Objetivo: distinguir un movimiento FUERTE (real) de uno FLOJO o FALSO.
// Combina:
//   1) ADX clásico  -> fuerza direccional pura del precio (sin sesgo)
//   2) Acuerdo Momentum/Flux -> ¿los dos módulos confirman la misma dirección?
//   3) Expansión de volatilidad -> ¿el ATR está creciendo o seguimos comprimidos?
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

strengthLen     = input.int (14   , "Periodo ADX"              , minval = 5, maxval = 50, group = "Fuerza del Movimiento")
atrRefLen       = input.int (50   , "Periodo ATR referencia"   , minval = 10,maxval = 200, group = "Fuerza del Movimiento")
strengthShow    = input.bool(true , "Mostrar Medidor de Fuerza (panel inferior)", group = "Fuerza del Movimiento")
strengthOnPanel = input.bool(true , "Agregar Fuerza al Panel IA", group = "Fuerza del Movimiento")
fuerteTh        = input.int (65   , "Umbral Fuerte"            , minval = 50,maxval = 90, group = "Fuerza del Movimiento")
midTh           = input.int (50   , "Umbral Agarrando Fuerza"  , minval = 30,maxval = 65, group = "Fuerza del Movimiento")
flojoTh         = input.int (35   , "Umbral Flojo"             , minval = 10,maxval = 50, group = "Fuerza del Movimiento")

// --- 1) ADX clásico (fuerza direccional, no importa el lado) ---
[diPlus, diMinus, adxVal] = ta.dmi(strengthLen, strengthLen)

// --- 2) ¿Momentum y Flux (ya calculados arriba: o y v) están de acuerdo? ---
bool confirmBull = o.o > 0 and v.o > 0
bool confirmBear = o.o < 0 and v.o < 0
bool disagree    = (o.o > 0 and v.o < 0) or (o.o < 0 and v.o > 0)

// --- 3) ¿La volatilidad se está expandiendo o seguimos comprimidos (squeeze)? ---
float atrNow       = ta.atr(strengthLen)
float atrAvg       = ta.sma(atrNow, atrRefLen)
bool  volExpanding = atrNow > atrAvg

// --- Score final de Fuerza (0-100) ---
float baseScore     = math.min(adxVal, 50) * 2
float bonusAgree    = (confirmBull or confirmBear) ? 15 : (disagree ? -15 : 0)
float bonusVol      = volExpanding ? 10 : ((s.h or s.m) ? -10 : 0)
float strengthScore = math.max(0.0, math.min(100.0, baseScore + bonusAgree + bonusVol))

string strengthLabel = ""
color  strengthColor = color.gray

if strengthScore >= fuerteTh
    strengthLabel := disagree ? "⚠️ FUERTE PERO DIVIDIDO" : "💪 FUERTE"
    strengthColor := disagree ? color.new(color.orange, 0) : color.new(color.green, 0)
else if strengthScore >= midTh
    strengthLabel := "📈 AGARRANDO FUERZA"
    strengthColor := color.new(color.yellow, 0)
else if strengthScore >= flojoTh
    strengthLabel := "📉 PERDIENDO FUERZA"
    strengthColor := color.new(color.orange, 0)
else
    strengthLabel := (s.h or s.m) ? "🌙 FLOJO (comprimido)" : "❌ FALSO / SIN FUERZA"
    strengthColor := color.new(color.red, 0)

string strengthText = "Fuerza: " + strengthLabel + " (" + str.tostring(math.round(strengthScore)) + "/100)"

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 🏛️ CONTEXTO INSTITUCIONAL — Panel Régimen de Mercado + Desviación VWAP
// Mismo panel del NEXUS OMEGA INSTITUTIONAL, adaptado a las variables ya
// calculadas en el Nova Oscillator (ADX de la Fuerza del Movimiento y el
// squeeze del propio indicador) en lugar de recalcular todo desde cero.
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

showInstitPanel = input.bool(true, "Mostrar Panel de Contexto Institucional", group = "Fuerza del Movimiento")

// --- Bloque calcado 1:1 de NEXUS OMEGA INSTITUTIONAL, aislado en sus propios inputs ---
// para que el texto del recuadro salga idéntico en ambos indicadores sin depender
// de ajustes de otras secciones del oscilador (strengthLen, squeeze propio, etc.)
institAdxLen   = input.int  (14  , "ADX Length"                  , group = "Fuerza del Movimiento")
institBbLen    = input.int  (20  , "BB Length (ancho normalizado)", group = "Fuerza del Movimiento")
institBbMult   = input.float(2.0 , "BB Mult"                     , group = "Fuerza del Movimiento")
adxTrendMin    = input.int  (25  , "ADX mínimo para 'Tendencia'" , minval = 10, maxval = 60, group = "Fuerza del Movimiento")
adxRangeMax    = input.int  (20  , "ADX máximo para 'Rango'"     , minval = 5,  maxval = 50, group = "Fuerza del Movimiento")

[institDiPlus, institDiMinus, institAdx] = ta.dmi(institAdxLen, institAdxLen)

float institBasis      = ta.sma(close, institBbLen)
float institDev        = institBbMult * ta.stdev(close, institBbLen)
float institBbWidth    = (institDev * 2) / institBasis * 100
float institBbWidthAvg = ta.sma(institBbWidth, institBbLen * 3)
bool  institVolaContracted = institBbWidth < institBbWidthAvg * 0.7

bool  regimeCompressed = institVolaContracted
bool  regimeTrending   = institAdx >= adxTrendMin and not regimeCompressed
bool  regimeRanging    = institAdx <  adxRangeMax and not regimeCompressed
string regimeLabel     = regimeCompressed ? "COMPRESIÓN (pre-expansión)" :
                          regimeTrending   ? "TENDENCIA"                  :
                          regimeRanging    ? "RANGO"                      : "TRANSICIÓN"
color  regimeColor     = regimeCompressed ? color.new(colsl, 10) :
                          regimeTrending   ? color.new(cpo  , 30) :
                          regimeRanging    ? color.new(color.gray, 20) : color.new(color.gray, 40)

float vwapVal    = ta.vwap(hlc3)
float vwapDevRaw = (close - vwapVal) / vwapVal * 100
color vwapDevCol = vwapDevRaw >= 0 ? cpo : cno

var table institPanel = table.new(position.middle_right, 2, 3, border_width = 2, border_color = color.new(color.black, 50))

if showInstitPanel and barstate.islast
    table.cell(institPanel, 0, 0, "Contexto Institucional", text_color = coltx, bgcolor = color.new(trnsp, 0) , text_size = size.tiny)
    table.cell(institPanel, 1, 0, ""                       ,                    bgcolor = color.new(trnsp, 0)                       )
    table.cell(institPanel, 0, 1, "Régimen"                , text_color = coltx, bgcolor = color.new(trnsp, 10), text_size = size.tiny)
    table.cell(institPanel, 1, 1, regimeLabel              , text_color = color.black, bgcolor = regimeColor  , text_size = size.tiny)
    table.cell(institPanel, 0, 2, "Desv. VWAP"             , text_color = coltx, bgcolor = color.new(trnsp, 10), text_size = size.tiny)
    table.cell(institPanel, 1, 2, str.tostring(math.round(vwapDevRaw * 100) / 100) + "%", text_color = vwapDevCol, bgcolor = color.new(trnsp, 10), text_size = size.tiny)

// --- Visual: Cinta histórica de Fuerza en la parte inferior, mismo estilo que las cintas de sobrecompra/sobreventa ---
// Recorre todo el indicador mostrando cómo evolucionó la fuerza vela a vela.
// En vez de degradado continuo (que mezcla tonos parecidos y cuesta leer), usa 4 BANDAS SÓLIDAS bien diferenciadas:
//   🟥 Rojo   = sin fuerza / movimiento falso   (< flojoTh)
//   🟧 Naranja= perdiendo fuerza / dudoso       (flojoTh - midTh)
//   🟡 Amarillo = agarrando fuerza              (midTh - fuerteTh)
//   🟩 Verde  = fuerza confirmada                (>= fuerteTh)
ribbonHeight = input.float(6.0, "Grosor Cinta de Fuerza", minval = 2.0, maxval = 20.0, step = 1.0, group = "Fuerza del Movimiento")
ribbonBase   = -100.0

color ribbonColor = strengthScore >= fuerteTh ? color.new(color.green , 0) :
                     strengthScore >= midTh    ? color.new(color.yellow, 0) :
                     strengthScore >= flojoTh  ? color.new(color.orange, 0) :
                                                  color.new(color.red   , 0)

plot(strengthShow ? ribbonBase + ribbonHeight : na, "Cinta de Fuerza", ribbonColor, 1, plot.style_columns, false, ribbonBase, display = display.pane)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 🤖 AI MINI PANEL — FIJO / PROFESIONAL (ESPAÑOL) + RESUMEN INTELIGENTE
// ✅ Orden: Veredicto, Momentum, Zona, Volatilidad, Money Flow
// ✅ Label fijo (no se mueve con el momentum)
// ✅ v5 safe (sin errores multiline)
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

// 🔧 Espacio fijo
offsetCols = input.int(3, "Espacio panel ↔ indicador", minval = 0, maxval = 12)

// 🎨 Color dinámico
useGradientColor = input.bool(true, "Color gradual por zona (invertido)")

// Ajustes
showMiniPanel   = input.bool(true, "Panel IA")
showMiniSignals = input.bool(true, "Señales IA")
showVerdict     = input.bool(true, "Mostrar resumen / veredicto de entrada", group = "Resumen Inteligente")

obLevel  = input.float(40.0, "Sobrecompra", step=1.0)
osLevel  = input.float(-40.0,"Sobreventa",  step=1.0)
nearBand = input.float(5.0,  "Proximidad",  step=0.5)
mfMin    = input.float(3.0,  "Umbral Money Flow", step=0.5)

momWeak   = input.float(2.5, "Momentum medio desde",  step=0.5)
momStrong = input.float(6.0, "Momentum fuerte desde", step=0.5)

// ── Zonas
bool isOS2   = o.o <= osLevel
bool isOB2   = o.o >= obLevel
bool nearOS2 = (not isOS2) and (o.o <= (osLevel + nearBand))
bool nearOB2 = (not isOB2) and (o.o >= (obLevel - nearBand))

// ── Money Flow
bool mfBull2 = v.o >  mfMin
bool mfBear2 = v.o < -mfMin

// ── Distancia al gatillo (puntos del oscilador y velas estimadas al ritmo actual)
velLen = input.int(3, "Velas para medir ritmo del oscilador", minval=1, maxval=10, group="Resumen Inteligente")
etaCap = input.int(20, "Máx. velas a proyectar (ETA)", minval=5, maxval=60, group="Resumen Inteligente")

float oscVelocity = (o.o - o.o[velLen]) / velLen   // puntos por vela; positivo = subiendo

float ptsToOS = o.o - osLevel   // puntos que faltan para tocar sobreventa (positivo = aún falta bajar)
float ptsToOB = obLevel - o.o   // puntos que faltan para tocar sobrecompra (positivo = aún falta subir)

float barsToOS = (ptsToOS > 0 and oscVelocity < 0) ? (ptsToOS / -oscVelocity) : na
float barsToOB = (ptsToOB > 0 and oscVelocity > 0) ? (ptsToOB /  oscVelocity) : na

// ── Confluencias BUY/SELL
bool hasBullConf2 = a.b or a.q or a.a or a.y
bool hasBearConf2 = a.s or a.w or a.c or a.x

bool newLong2  = hasBullConf2 and not hasBullConf2[1]
bool newShort2 = hasBearConf2 and not hasBearConf2[1]

// ── El momento ya pasó (la confluencia se acaba de apagar)
bool bullJustEnded = (not hasBullConf2) and hasBullConf2[1]
bool bearJustEnded = (not hasBearConf2) and hasBearConf2[1]

// ENCABEZADO
string signalNow2 = "⏳ EN ESPERA"
if newLong2
    signalNow2 := "🚀 LONG"
else if newShort2
    signalNow2 := "📉 SHORT"

string headerText2 = "SEÑAL: " + signalNow2

// COLOR ENCABEZADO
color headerColor2 = color.new(color.gray, 0)
if useGradientColor
    float momC2 = o.o
    if momC2 < osLevel
        momC2 := osLevel
    if momC2 > obLevel
        momC2 := obLevel
    headerColor2 := color.from_gradient(momC2, osLevel, obLevel, color.new(color.red, 0), color.new(color.green, 0))
else
    if isOS2
        headerColor2 := color.new(color.red, 0)
    else if isOB2
        headerColor2 := color.new(color.green, 0)
    else if nearOS2
        headerColor2 := color.new(color.red, 40)
    else if nearOB2
        headerColor2 := color.new(color.green, 40)
    else
        headerColor2 := color.new(color.gray, 0)

// MOMENTUM
float momDiff2 = math.abs(o.o - o.s)

string momDir2 = ""
if o.o > o.s
    momDir2 := "Alcista🟢"
else if o.o < o.s
    momDir2 := "Bajista🔴"
else
    momDir2 := "Neutral"

string momStr2 = ""
if momDiff2 >= momStrong
    momStr2 := "Fuerte 💥"
else if momDiff2 >= momWeak
    momStr2 := "Media ⚡"
else
    momStr2 := "Débil 🌙"

string momText2 = "Momentum: " + momDir2 + " (" + momStr2 + ")"

// ZONA
string zoneText2 = ""
if isOS2
    zoneText2 := "Zona: Sobreventa 🔻"
else if isOB2
    zoneText2 := "Zona: Sobrecompra 🔺"
else if nearOS2
    zoneText2 := "Zona: Próxima a sobreventa 🟥"
else if nearOB2
    zoneText2 := "Zona: Próxima a sobrecompra 🟩"
else
    zoneText2 := "Zona: Neutral ⚪"

// DISTANCIA AL GATILLO
string distText2 = ""
if isOS2
    distText2 := "Distancia: ya está en sobreventa"
else if isOB2
    distText2 := "Distancia: ya está en sobrecompra"
else if not na(barsToOS) and barsToOS <= etaCap
    distText2 := "Distancia: " + str.tostring(ptsToOS, "#.#") + " pts a sobreventa (≈" + str.tostring(math.round(barsToOS)) + " velas)"
else if not na(barsToOB) and barsToOB <= etaCap
    distText2 := "Distancia: " + str.tostring(ptsToOB, "#.#") + " pts a sobrecompra (≈" + str.tostring(math.round(barsToOB)) + " velas)"
else
    distText2 := "Distancia: sin acercamiento claro"

// VOLATILIDAD
string volText2 = ""
if s.h
    volText2 := "Volatilidad: Compresión alta 🧨"
else if s.m
    volText2 := "Volatilidad: Compresión normal 🗜️"
else if s.l
    volText2 := "Volatilidad: Compresión baja 💤"
else
    volText2 := "Volatilidad: Normal 🌿"

// MONEY FLOW (al final)
string mfText2 = ""
if mfBull2
    mfText2 := "Money Flow: Alcista "
else if mfBear2
    mfText2 := "Money Flow: Bajista "
else
    mfText2 := "Money Flow: Neutral "

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 🧠 VEREDICTO / RESUMEN DE ENTRADA
// Combina: confluencia activa/recién terminada, squeeze, zona,
// momentum y money flow, y divergencias — en una sola frase de acción.
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

string  verdictText  = ""
color   verdictColor = color.new(color.gray, 0)

if newLong2
    verdictText  := "🚀 COMPRA CONFIRMADA — Confluencia alcista recién activada, es el momento de evaluar entrada."
    verdictColor := color.new(color.green, 0)
else if newShort2
    verdictText  := "📉 VENTA CONFIRMADA — Confluencia bajista recién activada, es el momento de evaluar entrada."
    verdictColor := color.new(color.red, 0)
else if bullJustEnded
    verdictText  := "⌛ El momento de compra ya pasó — la confluencia alcista se apagó, espera la próxima formación."
    verdictColor := color.new(color.orange, 10)
else if bearJustEnded
    verdictText  := "⌛ El momento de venta ya pasó — la confluencia bajista se apagó, espera la próxima formación."
    verdictColor := color.new(color.orange, 10)
else if hasBullConf2
    verdictText  := "✅ Zona de compra sigue activa — evalúa si el precio aún no se ha movido demasiado antes de entrar."
    verdictColor := color.new(color.green, 30)
else if hasBearConf2
    verdictText  := "✅ Zona de venta sigue activa — evalúa si el precio aún no se ha movido demasiado antes de entrar."
    verdictColor := color.new(color.red, 30)
else if s.h
    verdictText  := "⏸️ ESPERA — Squeeze alto (volatilidad muy comprimida), el precio puede explotar en cualquier dirección, aún no es momento de entrar."
    verdictColor := color.new(color.orange, 0)
else if nearOS2 and momDir2 == "Alcista🟢" and mfBull2
    string etaOS1 = na(barsToOS) ? "" : " — ≈" + str.tostring(math.round(barsToOS)) + " velas (" + str.tostring(ptsToOS, "#.#") + " pts)"
    verdictText  := "🔔 Muy cerca de SOBREVENTA" + etaOS1 + ", con momentum y flujo ya alcistas — vigila el cruce de confluencia."
    verdictColor := color.new(color.green, 40)
else if nearOB2 and momDir2 == "Bajista🔴" and mfBear2
    string etaOB1 = na(barsToOB) ? "" : " — ≈" + str.tostring(math.round(barsToOB)) + " velas (" + str.tostring(ptsToOB, "#.#") + " pts)"
    verdictText  := "🔔 Muy cerca de SOBRECOMPRA" + etaOB1 + ", con momentum y flujo ya bajistas — vigila el cruce de confluencia."
    verdictColor := color.new(color.red, 40)
else if nearOS2
    verdictText  := "🟨 A " + str.tostring(ptsToOS, "#.#") + " pts de sobreventa, pero momentum/flujo aún no confirman — espera antes de entrar."
    verdictColor := color.new(color.yellow, 0)
else if nearOB2
    verdictText  := "🟨 A " + str.tostring(ptsToOB, "#.#") + " pts de sobrecompra, pero momentum/flujo aún no confirman — espera antes de entrar."
    verdictColor := color.new(color.yellow, 0)
else if not na(barsToOS) and barsToOS <= etaCap
    verdictText  := "🚶 Aún fuera de zona, pero el oscilador viaja hacia SOBREVENTA a ≈" + str.tostring(math.round(barsToOS)) + " velas (" + str.tostring(ptsToOS, "#.#") + " pts) al ritmo actual — todavía no es momento de entrar."
    verdictColor := color.new(color.green, 55)
else if not na(barsToOB) and barsToOB <= etaCap
    verdictText  := "🚶 Aún fuera de zona, pero el oscilador viaja hacia SOBRECOMPRA a ≈" + str.tostring(math.round(barsToOB)) + " velas (" + str.tostring(ptsToOB, "#.#") + " pts) al ritmo actual — todavía no es momento de entrar."
    verdictColor := color.new(color.red, 55)
else if isOS2
    verdictText  := "⚠️ Ya en sobreventa pero sin confluencia — el movimiento pudo haberse adelantado, cuidado con entrar tarde."
    verdictColor := color.new(color.orange, 20)
else if isOB2
    verdictText  := "⚠️ Ya en sobrecompra pero sin confluencia — el movimiento pudo haberse adelantado, cuidado con entrar tarde."
    verdictColor := color.new(color.orange, 20)
else if a.e
    verdictText  := "🔍 Divergencia bajista detectada — posible giro a la baja, espera confirmación antes de vender."
    verdictColor := color.new(color.purple, 0)
else if a.f
    verdictText  := "🔍 Divergencia alcista detectada — posible giro al alza, espera confirmación antes de comprar."
    verdictColor := color.new(color.purple, 0)
else
    verdictText  := "⏳ Mercado en zona neutral — sin señal clara, mejor esperar el próximo desarrollo."
    verdictColor := color.new(color.gray, 0)

// ORDEN FINAL: Momentum, Zona, Fuerza, Volatilidad, Money Flow, Distancia, Veredicto
string infoLine2 = momText2 + "\n" + zoneText2 + (strengthOnPanel ? "\n" + strengthText : "") + "\n" + volText2 + "\n" + mfText2 + "\n" + distText2

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// RENDER — PANEL FIJO (NO SE MUEVE VERTICALMENTE)
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

int   PANEL_BARS_RIGHT = 6
float PANEL_Y_PAD      = 14.0
int   WRAP_CHARS       = 50

wrapLine(string txt, int maxLen) =>
    string out = ""
    int L = str.length(txt)
    int i = 0
    while i < L
        int j = i + maxLen
        if j > L
            j := L
        out := out + str.substring(txt, i, j)
        if j < L
            out := out + "\n"
        i := j
    out

wrapMultiline(string txt, int maxLen) =>
    string result = ""
    array<string> lines = str.split(txt, "\n")
    for k = 0 to array.size(lines) - 1
        string ln = array.get(lines, k)
        result := result + wrapLine(ln, maxLen)
        if k < array.size(lines) - 1
            result := result + "\n"
    result

var label lbPanel = na

if barstate.islast and showMiniPanel
    int   xA = bar_index + PANEL_BARS_RIGHT
    float yA = 0.0

    string bodyWrapped = wrapMultiline(infoLine2, WRAP_CHARS)
    string panelText = headerText2 + "\n\n" + bodyWrapped

    if showVerdict
        string verdictWrapped = wrapMultiline(verdictText, WRAP_CHARS)
        panelText := panelText + "\n\n" + verdictWrapped
    else
        panelText := panelText + "\n"

    // El color del label refleja el veredicto cuando está activo,
    // de lo contrario usa el degradado de zona del encabezado.
    color panelColor = showVerdict ? verdictColor : headerColor2

    if na(lbPanel)
        lbPanel := label.new(xA, yA + PANEL_Y_PAD, panelText, xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_left, textcolor=color.white, color=panelColor, size=size.normal)
    else
        label.set_xy(lbPanel, xA, yA + PANEL_Y_PAD)
        label.set_text(lbPanel, panelText)
        label.set_textcolor(lbPanel, color.white)
        label.set_color(lbPanel, panelColor)
        label.set_style(lbPanel, label.style_label_left)
        label.set_size(lbPanel, size.normal)

if barstate.islast and not showMiniPanel
    if not na(lbPanel)
        label.delete(lbPanel)
        lbPanel := na

// Señales visuales (solo cuando nace nueva confluencia)
plotshape(showMiniSignals and newLong2  ? o.s : na, title="IA LONG",  style=shape.triangleup,   location=location.absolute, color=color.new(color.green, 0), size=size.tiny)
plotshape(showMiniSignals and newShort2 ? o.s : na, title="IA SHORT", style=shape.triangledown, location=location.absolute, color=color.new(color.red, 0),   size=size.tiny)
