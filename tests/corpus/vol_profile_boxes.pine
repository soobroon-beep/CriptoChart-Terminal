//@version=5
indicator("Mini Volume Profile", overlay=true, max_boxes_count=100)
rows = input.int(20, "Rows", minval=5, maxval=50)
lookback = input.int(100, "Lookback", minval=10)
width = input.int(30, "Width (bars)")
up = color.new(color.teal, 50)
dn = color.new(color.red, 50)
hi = ta.highest(high, lookback)
lo = ta.lowest(low, lookback)
if barstate.islast
    step = (hi - lo) / rows
    vols = array.new_float(rows, 0.0)
    for i = 0 to lookback - 1
        mid = (high[i] + low[i]) / 2
        idx = math.min(rows - 1, math.floor((mid - lo) / step))
        array.set(vols, idx, array.get(vols, idx) + volume[i])
    mx = array.max(vols)
    for r = 0 to rows - 1
        v = array.get(vols, r)
        w = int(v / mx * width)
        box.new(bar_index + 2, lo + step * (r + 1), bar_index + 2 + w, lo + step * r, border_color=na, bgcolor=v == mx ? color.new(color.yellow, 30) : up)
