//@version=5
indicator("Misc Oscillators", overlay=false, precision=2)
src = input.source(close, "Source")
len = input.int(14, "Length", minval=2, maxval=200, group="Main", tooltip="bars")
mode = input.string("Fast", "Mode", options=["Fast", "Slow"], inline="a")
useSar = input.bool(true, "SAR")
col = input.color(color.blue, "Color")
tsi = ta.tsi(src, 5, 25)
cmo = ta.cmo(src, len)
cog = ta.cog(src, len)
cor = ta.correlation(close, volume, len)
alma = ta.alma(src, len, 0.85, 6)
sar = ta.sar(0.02, 0.02, 0.2)
plot(tsi, "TSI", col)
plot(cmo, "CMO", color.orange)
plot(cog, "COG", color.green, display=display.data_window)
plot(cor * 50, "Corr", color.purple)
plot(alma - close, "ALMA diff")
plot(useSar ? sar - close : na, "SAR", style=plot.style_circles)
plot(ta.range(close, 10) + ta.max(high) * 0 + ta.min(low) * 0, "range")
plotchar(ta.crossover(tsi, 0), "x", "✔", location.bottom)
linesArr = array.new_line()
if barstate.islast
    l1 = line.new(bar_index - 10, 0.0, bar_index, 0.0)
    l2 = line.new(bar_index - 10, 10.0, bar_index, 10.0)
    linefill.new(l1, l2, color.new(color.blue, 80))
    array.push(linesArr, l1)
