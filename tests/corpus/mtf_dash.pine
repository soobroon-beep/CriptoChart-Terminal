//@version=5
indicator("MTF Trend Dashboard", overlay=true)
tf1 = input.timeframe("15", "TF1")
tf2 = input.timeframe("60", "TF2")
tf3 = input.timeframe("240", "TF3")
tf4 = input.timeframe("D", "TF4")
emaLen = input.int(21, "EMA")
trend(tf) =>
    request.security(syminfo.tickerid, tf, close > ta.ema(close, emaLen) ? 1 : -1, lookahead=barmerge.lookahead_off)
t1 = trend(tf1)
t2 = trend(tf2)
t3 = trend(tf3)
t4 = trend(tf4)
var tbl = table.new(position.top_right, 2, 5, frame_color=color.gray, frame_width=1, border_width=1)
cellColor(t) => t > 0 ? color.new(color.green, 20) : color.new(color.red, 20)
if barstate.islast
    table.cell(tbl, 0, 0, "TF", text_color=color.white, bgcolor=color.new(color.black, 20))
    table.cell(tbl, 1, 0, "Trend", text_color=color.white, bgcolor=color.new(color.black, 20))
    table.cell(tbl, 0, 1, tf1, text_color=color.white)
    table.cell(tbl, 1, 1, t1 > 0 ? "▲" : "▼", bgcolor=cellColor(t1), text_color=color.white)
    table.cell(tbl, 0, 2, tf2, text_color=color.white)
    table.cell(tbl, 1, 2, t2 > 0 ? "▲" : "▼", bgcolor=cellColor(t2), text_color=color.white)
    table.cell(tbl, 0, 3, tf3, text_color=color.white)
    table.cell(tbl, 1, 3, t3 > 0 ? "▲" : "▼", bgcolor=cellColor(t3), text_color=color.white)
    table.cell(tbl, 0, 4, tf4, text_color=color.white)
    table.cell(tbl, 1, 4, t4 > 0 ? "▲" : "▼", bgcolor=cellColor(t4), text_color=color.white)
plot(ta.ema(close, emaLen), "EMA", color.orange)
