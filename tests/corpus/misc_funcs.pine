//@version=5
indicator("Misc Functions", overlay=false)
a = math.abs(-3) + math.ceil(2.1) + math.floor(2.9) + math.max(1, 2, 3) + math.min(4, 5) + math.pow(2, 3) + math.sqrt(16) + math.round(2.567, 2) + math.sign(-4)
b = math.log(10) + math.exp(0) + math.log10(100) + math.sin(0) + math.cos(0) + math.tan(0) + math.todegrees(math.pi) + math.toradians(180)
c = nz(na, 5) + (na(close) ? 1 : 0) + (barstate.isfirst ? 1 : 0) + bar_index + time / 1e12
d = hl2 + hlc3 + ohlc4 + hlcc4 + tr + volume
e = ta.highestbars(high, 5) + ta.lowestbars(low, 5) + ta.cum(1) + ta.change(close, 2) + ta.mom(close, 3) + ta.roc(close, 3)
f = ta.atr(14) + ta.rsi(close, 14) + ta.cci(close, 20) + ta.mfi(hlc3, 14) + ta.wpr(14) + ta.bbw(close, 20, 2) + ta.kcw(close, 20, 2)
g = str.length("abc") + str.pos("abc", "c") + (str.contains("abc", "b") ? 1 : 0) + str.tonumber("12")
t1 = str.upper("a") + str.lower("B") + str.substring("hello", 1, 3) + str.replace_all("aXa", "X", "-") + str.format("{0}-{1}", 1, 2) + str.repeat("a", 2)
[mac, sig, hst] = ta.macd(close, 12, 26, 9)
[mid, up, lo] = ta.bb(close, 20, 2)
[di1, di2, adx] = ta.dmi(14, 14)
[st, sdir] = ta.supertrend(3, 10)
plot(a + b, "ab")
plot(c + d, "cd")
plot(e + f, "ef")
plot(g + str.length(t1), "g")
plot(mac + sig + hst + mid + up + lo + di1 + di2 + adx + st + sdir, "tuples")
plot(ta.tr(true) + ta.vwap + ta.obv, "dyn")
plot(timeframe.in_seconds() + (timeframe.isintraday ? 1 : 0) + (timeframe.isdaily ? 1 : 0) + dayofweek + month + year + hour + minute + dayofmonth + weekofyear, "time")
plot(syminfo.mintick + syminfo.pointvalue + (syminfo.ticker == "x" ? 1 : 0) + last_bar_index + (barstate.islast ? 1 : 0) + (barstate.isconfirmed ? 1 : 0), "sym")
