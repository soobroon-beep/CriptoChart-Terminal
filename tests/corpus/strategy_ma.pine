//@version=5
strategy("MA Cross Strategy", overlay=true, margin_long=100, margin_short=100, default_qty_type=strategy.percent_of_equity, default_qty_value=10)
fastLen = input.int(10, "Fast")
slowLen = input.int(30, "Slow")
fast = ta.sma(close, fastLen)
slow = ta.sma(close, slowLen)
longCondition = ta.crossover(fast, slow)
if (longCondition)
    strategy.entry("My Long Entry Id", strategy.long)
shortCondition = ta.crossunder(fast, slow)
if (shortCondition)
    strategy.entry("My Short Entry Id", strategy.short)
strategy.exit("exit", "My Long Entry Id", stop=close*0.95, limit=close*1.05)
plot(fast, color=color.blue)
plot(slow, color=color.orange)
