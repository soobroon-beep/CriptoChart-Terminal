//@version=5
indicator("Loops and Recursion", overlay=false)
fib(n) => n < 2 ? n : fib(n - 1) + fib(n - 2)
sumTo(n) =>
    s = 0
    i = 0
    while i <= n
        s += i
        i += 1
    s
f = fib(10)
total = 0.0
for i = 0 to 4
    if i == 3
        continue
    if i == 4
        break
    total += close[i]
var float acc = 0
acc := acc + (bar_index % 3 == 0 ? 1 : 0)
x = switch
    close > open => 1
    close < open => -1
    => 0
plot(f, "fib")
plot(sumTo(5), "sum")
plot(nz(total), "total")
plot(acc, "acc")
plot(x, "x", style=plot.style_histogram)
for [i, v] in array.from(1, 2, 3)
    total += v
